{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "name":"infyomlabs/adminlte-templates",
            "version":"dev-backup-10",
            "url": "https://github.com/dhiaamostafa46/adminlte-templates.git"

        },
        {
            "type": "vcs",
            "name":"nwidart/laravel-modules",
            "version":"dev-master",
            "url": "https://github.com/dhiaamostafa46/laravel-modules.git"
        }
    ],
    "require": {
        "php": "^8.1",
        "asantibanez/livewire-charts": "^4.1",
        "astrotomic/laravel-translatable": "^11.12",
        "darkaonline/l5-swagger": "8.*",
        "dasundev/livewire-dropzone": "^1.0",
        "google/auth": "^1.50",
        "guzzlehttp/guzzle": "^7.2",
        "hisorange/browser-detect": "^5.0",
        "infyomlabs/adminlte-templates": "dev-backup-10",
        "infyomlabs/generator-builder": "^1.0",
        "infyomlabs/laravel-generator": "^6.0",
        "infyomlabs/swagger-generator": "^3.0",
        "intervention/image": "^2.7",
        "jantinnerezo/livewire-alert": "^3.0",
        "ladumor/laravel-pwa": "^0.0.4",
        "laracasts/flash": "*",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.8",
        "laravelcollective/html": "^6.4",
        "livewire/livewire": "^3.5",
        "maatwebsite/excel": "^3.1",
        "mhmiton/laravel-modules-livewire": "^3.0",
        "mohamedsabil83/laravel-hijrian": "^4.2",
        "mpdf/mpdf": "^8.2",
        "nwidart/laravel-modules": "dev-master",
        "picqer/php-barcode-generator": "^3.2",
        "salla/zatca": "^3.0",
        "sentry/sentry-laravel": "^4.8",
        "silviolleite/laravelpwa": "^2.0",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-notification-log": "^1.3",
        "spatie/laravel-permission": "^6.3",
        "stichoza/google-translate-php": "^5.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/"
        }
        ,
        "files": [
           "app/Helpers/TimeHelper.php",
            "app/Helpers/SettingSystemBtc.php"
         ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\": "Modules/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
