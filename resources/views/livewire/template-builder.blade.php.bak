        /* Saudi Invoice Styling from invoicetemplate4k & invoicetemplatesimple */
        .saudi-invoice {
            background: #fff;
            font-family: 'Cairo', 'Arial', sans-serif;
            color: #000;
            padding: 10px;
            width: 100%;
